# ── mxpf-ai-harness example env ─────────────────────────────────────────────
# Fill in secrets locally. This file is gitignored (.env); keep .env.sample clean.

# --- OpenRouter free router (recommended for examples) ---------------------
# Get a key: https://openrouter.ai/keys
# Free models: https://openrouter.ai/openrouter/free
# OpenAI-compatible pipe → provider must be "openai"

MXPF_HARNESS_API_KEY=          # paste OpenRouter API key (sk-or-v1-...)
MXPF_HARNESS_PROVIDER=openai
MXPF_HARNESS_MODEL=openrouter/free
MXPF_HARNESS_BASE_URL=https://openrouter.ai/api/v1

# --- Alternatives (comment OpenRouter block above, use one of these) -------
# Direct Anthropic:
# MXPF_HARNESS_PROVIDER=anthropic
# MXPF_HARNESS_MODEL=claude-sonnet-4-5
# MXPF_HARNESS_API_KEY=
# MXPF_HARNESS_BASE_URL=

# Specific free OpenRouter model (instead of the free router):
# MXPF_HARNESS_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── LangSmith (optional — ready, not required) ───────────────────────────────
# Workspace: https://smith.langchain.com/o/b7827736-fb11-449f-aca5-8aa59d6a7035

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mxpf-ai-harness-examples
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
