# ── mxpf-ai-harness example env ─────────────────────────────────────────────
# Fill in secrets locally. This file is gitignored (.env); keep .env.sample clean.

# Harness model (required for live: npm run basic | langgraph)
MXPF_HARNESS_API_KEY=
# anthropic | openai
MXPF_HARNESS_PROVIDER=anthropic
MXPF_HARNESS_MODEL=claude-sonnet-4-5
# Optional pipes (OpenRouter, LiteLLM, Ollama gateway, etc.)
# MXPF_HARNESS_BASE_URL=https://openrouter.ai/api

# ── LangSmith (optional — ready, not required) ───────────────────────────────
# Workspace: https://smith.langchain.com/o/b7827736-fb11-449f-aca5-8aa59d6a7035
# Create an API key in LangSmith → Settings → API Keys, then paste below.
# When set, LangGraph live runs send traces automatically.

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mxpf-ai-harness-examples
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Legacy aliases (also accepted by the helper)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=mxpf-ai-harness-examples
